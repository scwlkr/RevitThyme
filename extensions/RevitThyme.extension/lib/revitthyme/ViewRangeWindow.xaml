<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevitThyme - Visual View Range" Width="1190" Height="790"
        MinWidth="1020" MinHeight="730" WindowStartupLocation="CenterOwner"
        Background="#F5F4EE" FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="MinWidth" Value="100"/><Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#C8CEC6"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="7,5"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="#C8CEC6"/>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="6,4"/></Style>
    <Style TargetType="Slider"><Setter Property="Margin" Value="0,6,0,0"/></Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <StackPanel><TextBlock Text="Visual View Range" FontSize="25" FontWeight="SemiBold" Foreground="#225B50"/>
        <TextBlock x:Name="view_title" Margin="0,4,0,0" Foreground="#656A62"/></StackPanel>
      <Border DockPanel.Dock="Right" Background="#E4EBE0" CornerRadius="4" Padding="12,8" HorizontalAlignment="Right">
        <TextBlock Text="PREVIEW ONLY UNTIL APPLY" Foreground="#385B43" FontSize="11" FontWeight="SemiBold"/>
      </Border>
    </DockPanel>
    <Border Grid.Row="1" Background="White" BorderBrush="#D8DED4" BorderThickness="1" Padding="12" Margin="0,0,0,14">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <TextBlock Text="Offsets in" VerticalAlignment="Center" Margin="16,0,8,0"/>
          <ComboBox x:Name="unit_picker" Width="75"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,12,0">
          <TextBlock Text="Section axis" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox x:Name="axis_picker" Width="75"/>
        </StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
          <TextBlock Text="Slice position" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Slider x:Name="position_slider" Grid.Column="1" Minimum="0" Maximum="100" Value="50" Margin="0" VerticalAlignment="Center"/>
          <TextBlock x:Name="position_label" Grid.Column="2" Text="50%" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
      </DockPanel>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="355"/></Grid.ColumnDefinitions>
      <Grid Margin="0,0,16,0">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#D8DED4" BorderThickness="1" CornerRadius="4">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock x:Name="section_title" Text="MODEL SECTION  /  cached solid geometry" Margin="14,12" FontSize="11" FontWeight="SemiBold" Foreground="#686D63"/>
            <Canvas x:Name="section_canvas" Grid.Row="1" ClipToBounds="True" Margin="8,0,8,8" MinHeight="250"/>
          </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="White" BorderBrush="#D8DED4" BorderThickness="1" Padding="8">
            <StackPanel><TextBlock Text="PLAN LOCATOR" FontSize="10" Foreground="#686D63"/>
              <Canvas x:Name="locator_canvas" Height="82" ClipToBounds="True" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,0,0">
            <TextBlock Text="Explore a different cut through the model with the axis and position controls." TextWrapping="Wrap" Foreground="#4D554B"/>
            <TextBlock x:Name="geometry_note" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#716D59"/>
          </StackPanel>
        </Grid>
      </Grid>
      <Border Grid.Column="1" Background="White" BorderBrush="#D8DED4" BorderThickness="1" Padding="16" CornerRadius="4">
        <StackPanel><TextBlock Text="Range planes" FontSize="18" FontWeight="SemiBold" Foreground="#2C4D41"/>
          <TextBlock Text="Offsets are relative to each existing level reference. Drag or type a value." TextWrapping="Wrap" Foreground="#686D63" Margin="0,5,0,8"/>
          <StackPanel x:Name="plane_rows"/>
          <Button x:Name="reset_button" Content="Reset to current range" Margin="0,10,0,0" HorizontalAlignment="Left" Padding="10,5"/>
        </StackPanel>
      </Border>
    </Grid>
    <Border Grid.Row="3" x:Name="validation_border" Background="#E8EEE2" Padding="12,9" CornerRadius="4" Margin="0,14,0,14">
      <TextBlock x:Name="validation_text" TextWrapping="Wrap" Foreground="#3E5941"/>
    </Border>
    <DockPanel Grid.Row="4">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button x:Name="cancel_button" Content="Cancel" IsCancel="True"/>
        <Button x:Name="apply_button" Content="Apply view range" Background="#276A59" Foreground="White" FontWeight="SemiBold"/>
      </StackPanel>
      <TextBlock Text="Approximate solid section; Revit visibility rules may differ. Changes affect this view only." TextWrapping="Wrap" Foreground="#6C7166" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/>
    </DockPanel>
  </Grid>
</Window>
